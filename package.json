{
  "name": "content-ops-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node scripts/apply-sql.mjs",
    "build:sql": "{ echo \"-- ONE-FILE DATABASE SETUP: schema.sql + every migration, in order. Run once on a new Supabase project.\"; echo; cat supabase/schema.sql; for f in $(ls supabase/migration_*.sql | sort); do echo; echo \"-- ----- $(basename $f) -----\"; cat \"$f\"; done; } > supabase/setup_all.sql",
    "build:docs": "npx tsx scripts/build-docs.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/qrcode": "^1.5.6",
    "hls.js": "^1.7.1",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.24.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
